{
  "id": "research-agent",
  "name": "Research Agent",
  "description": "Conducts web research and produces structured reports with citations on any business topic.",
  "specJson": {
    "version": 2,
    "goal": "Research a topic thoroughly and produce a structured, cited report",
    "triggers": [
      { "name": "research_request", "kind": "event", "description": "Someone asks for research on a topic" },
      { "name": "market_analysis_request", "kind": "event", "description": "Someone asks for market or competitor analysis" }
    ],
    "results": [
      { "name": "research_brief", "terminal": false, "description": "Scoped questions, time horizon, and constraints" },
      { "name": "source_corpus", "terminal": false, "description": "Retrieved sources with raw extracts" },
      { "name": "verified_findings", "terminal": false, "description": "Claims corroborated by at least two sources" },
      { "name": "source_citations", "terminal": true, "schema": "citation[]{title,url,published_at}", "description": "Citation list for every retained claim" },
      { "name": "research_report", "terminal": true, "schema": "markdown_table[Rank,Tool,License,Stars,RedditScore,Summary]", "description": "Final structured report" }
    ],
    "chains": [
      {
        "id": "rs-1",
        "trigger": "research_request",
        "capability": "clarify_scope",
        "inputs": [{ "port": "request", "from": "trigger", "ref": "research_request" }],
        "result": "research_brief",
        "decision": "Ask at most two questions. Default the time horizon to the past 12 months when unspecified.",
        "gate": { "mode": "auto", "onFailure": "stop" }
      },
      {
        "id": "rs-2",
        "trigger": "market_analysis_request",
        "capability": "clarify_scope",
        "inputs": [{ "port": "request", "from": "trigger", "ref": "market_analysis_request" }],
        "result": "research_brief",
        "gate": { "mode": "auto", "onFailure": "stop" }
      },
      {
        "id": "rs-3",
        "trigger": "research_brief",
        "capability": "web_search",
        "inputs": [
          { "port": "queries", "from": "result", "ref": "research_brief" },
          { "port": "sources", "from": "parameter", "value": "github, reddit, vendor documentation" }
        ],
        "result": "source_corpus",
        "gate": { "mode": "auto", "onFailure": "retry", "maxRetries": 3 }
      },
      {
        "id": "rs-4",
        "trigger": "source_corpus",
        "capability": "verify_facts",
        "inputs": [{ "port": "sources", "from": "result", "ref": "source_corpus" }],
        "result": "verified_findings",
        "decision": "Drop any claim that is not corroborated by at least two independent sources.",
        "gate": { "mode": "auto", "onFailure": "stop" }
      },
      {
        "id": "rs-5",
        "trigger": "verified_findings",
        "capability": "citation_formatter",
        "inputs": [{ "port": "finding", "from": "result", "ref": "verified_findings" }],
        "result": "source_citations",
        "gate": { "mode": "auto", "onFailure": "stop" }
      },
      {
        "id": "rs-6",
        "trigger": "source_citations",
        "capability": "document_summarizer",
        "inputs": [
          { "port": "findings", "from": "result", "ref": "verified_findings" },
          { "port": "citations", "from": "result", "ref": "source_citations" }
        ],
        "result": "research_report",
        "decision": "Cite only findings present in verified_findings. Never invent a source.",
        "gate": { "mode": "auto", "onFailure": "escalate" }
      }
    ],
    "tools": ["clarify_scope", "web_search", "verify_facts", "citation_formatter", "document_summarizer"],
    "knowledgeSources": []
  },
  "model": "ollama",
  "isStarter": true,
  "createdAt": "2026-10-20T00:00:00.000Z",
  "updatedAt": "2026-10-20T00:00:00.000Z"
}
